      "source": [
        "from sklearn.preprocessing import StandardScaler\n",
        "\n",
        "scaler = StandardScaler()\n",
        "\n",
        "df[\"Amount_scaled\"] = scaler.fit_transform(df[[\"Amount\"]])\n",
        "\n",
        "df.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "Ur5vijn1Kbzt"
      },
      "outputs": [],
      "source": [
        "from sklearn.model_selection import train_test_split\n",
        "\n",
        "# Selecionando TODAS as características existentes no DataFrame 'df', exceto a coluna 'Class'.\n",
        "# Isso inclui 'Time', 'Amount', 'Amount_log' e 'Amount_scaled' além das features 'V' originais.\n",
        "X = df.drop(\"Class\", axis = 1)\n",
        "y = df[\"Class\"] # o que queremos saber, as categorias\n",
        "\n",
        "X_train, X_test, y_train, y_test = train_test_split(\n",
        "    X, y, stratify=y, test_size=0.2, random_state=42)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "90438233",
        "outputId": "cda0f8e2-c784-40fd-eb50-4ebff87a9018"
      },
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Conjuntos de dados preparados:\n",
            "X_train (full features) shape: (227845, 32)\n",
            "X_test (full features) shape: (56962, 32)\n",
            "X_train_reduced (reduced features) shape: (227845, 29)\n",
            "X_test_reduced (reduced features) shape: (56962, 29)\n",
            "y_train shape: (227845,)\n",
            "y_test shape: (56962,)\n"
          ]
        }
      ],
      "source": [
        "# Separando as features (X) da variável alvo (y)\n",
        "# X_full conterá todas as features (Time, Amount, Amount_log, Amount_scaled, V1-V28)\n",
        "features_full = df.drop(\"Class\", axis=1).columns.tolist()\n",
        "X_full = df[features_full]\n",
        "y = df[\"Class\"]\n",
        "\n",
        "# X_reduced conterá apenas as features V1-V28 e Amount_scaled\n",
        "features_reduced = ['V' + str(i) for i in range(1, 29)] + ['Amount_scaled']\n",
        "X_reduced = df[features_reduced]\n",
        "\n",
        "# Divisão dos dados para o conjunto FULL\n",
        "X_train, X_test, y_train, y_test = train_test_split(X_full, y, stratify=y, test_size=0.2, random_state=42)\n",
        "\n",
        "# Divisão dos dados para o conjunto REDUZIDO\n",
        "X_train_reduced, X_test_reduced, _, _ = train_test_split(X_reduced, y, stratify=y, test_size=0.2, random_state=42)\n",
        "\n",
        "print(\"Conjuntos de dados preparados:\")\n",
        "print(f\"X_train (full features) shape: {X_train.shape}\")\n",
        "print(f\"X_test (full features) shape: {X_test.shape}\")\n",
        "print(f\"X_train_reduced (reduced features) shape: {X_train_reduced.shape}\")\n",
        "print(f\"X_test_reduced (reduced features) shape: {X_test_reduced.shape}\")\n",
        "print(f\"y_train shape: {y_train.shape}\")\n",
        "print(f\"y_test shape: {y_test.shape}\")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "4Qv3w3DMuBX0"
      },
      "source": [
        "#Regressão Logística"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
