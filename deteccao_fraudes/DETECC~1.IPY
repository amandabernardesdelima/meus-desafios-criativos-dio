      "source": [
        "# Definindo os dados utilizados\n",
        "import pandas as pd\n",
        "\n",
        "url = \"https://storage.googleapis.com/download.tensorflow.org/data/creditcard.csv\"\n",
        "\n",
        "df = pd.read_csv(url)\n",
        "\n",
        "df.head()"
      ]
    },
